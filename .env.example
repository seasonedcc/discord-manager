# Your bot's token: Developer Portal -> your app -> Bot -> Reset Token
DISCORD_BOT_TOKEN=

# Your own Discord user id (Settings -> Advanced -> Developer Mode, then
# right-click your name -> Copy User ID). Only your 🔖 reactions become bookmarks.
DISCORD_OWNER_USER_ID=

# The server to manage (right-click the server name -> Copy Server ID)
DISCORD_GUILD_ID=

# Where the local event store lives
DATABASE_PATH=./data/discord-manager.db
