{
  "include": ["app/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "isolatedModules": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "target": "ES2022",
    "strict": true,
    "allowJs": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "~/*": ["./app/*"]
    },
    "noEmit": true
  }
}
